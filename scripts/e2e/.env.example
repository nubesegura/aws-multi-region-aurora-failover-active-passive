# Template for the DR drill runner settings (versioned, placeholder values only).
# Copy to ".env" in this folder (git-ignored) and replace every value with your own.

# Cognito user of the drill (created by provision_users.py --only e2e-runner) and its password.
E2E_USERNAME=
E2E_PASSWORD=
# Public API domain of the deployed demo (host name only, no scheme).
API_DOMAIN_NAME=
# GitHub repository that owns the workflows, as owner/name.
GITHUB_REPOSITORY=
# Named AWS CLI profile with read access to the prod account.
AWS_PROFILE=
# Primary data region, secondary data region and global (edge) region.
AWS_REGION_PRIMARY=
AWS_REGION_SECONDARY=
AWS_REGION_GLOBAL=
# Environment tier used in resource names and in the SSM path /drdemo/<ENV_TYPE>/cognito/*.
ENV_TYPE=
# Optional: PEM file with extra CA certificates (needed only behind TLS inspection); a relative path is
# resolved from this folder.
# AWS_CA_BUNDLE=
# Optional: seconds between two write probe movements (default 1).
# PROBE_RATE_SECONDS=1
# Optional: seconds of each steady phase of the drill (default 60).
# PHASE_STEADY_SECONDS=60
