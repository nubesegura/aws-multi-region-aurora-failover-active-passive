# Template for provision_users.py settings (versioned, placeholder values only).
# Copy to ".env" in this folder (git-ignored) and replace every value with your own.

# Named AWS CLI profile that can administer the Cognito user pools.
AWS_PROFILE=example-admin-profile
# Region of the primary user pool and region of the replica user pool.
AWS_REGION_PRIMARY=eu-west-1
AWS_REGION_SECONDARY=eu-central-1
# Environment tier used in the SSM path /drdemo/<ENV_TYPE>/cognito/UserPoolId.
ENV_TYPE=prod
# Seconds to wait for the replica pool to show the users as CONFIRMED.
COGNITO_REPLICATION_TIMEOUT=60
# E-mail addresses of the two demo users.
DEMO_BANK_EMAIL=bank-operator@example.invalid
DEMO_DASHBOARD_EMAIL=dashboard-viewer@example.invalid
# Passwords of the two demo users (min. 12 chars, upper, lower, digit and symbol).
DEMO_BANK_PASSWORD=Example-Bank-Passw0rd!
DEMO_DASHBOARD_PASSWORD=Example-Dash-Passw0rd!
# Optional end-to-end test user (created by: provision_users.py --only e2e-runner). Leave both empty to skip it.
DEMO_E2E_EMAIL=e2e-runner@example.invalid
DEMO_E2E_PASSWORD=Example-E2e-Passw0rd!
# Optional: PEM file with extra CA certificates (needed only behind TLS inspection); path relative to this folder.
# AWS_CA_BUNDLE=ca-bundle.pem
