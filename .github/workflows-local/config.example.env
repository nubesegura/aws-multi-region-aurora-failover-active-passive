# Local workflow configuration template (versioned, placeholders only).
# Copy this file to .github/workflows-local/prod.env (which is git-ignored) and adjust for your local workstation.
# You can also run `bash scripts/sync-github-env.sh` to sync these values to the GitHub "prod" Environment.
# Never commit real email addresses, account IDs, or passwords.

AWS_PROFILE=tf-local-admin-prod
AWS_REGION_GLOBAL=us-east-1
AWS_REGION_PRIMARY=us-east-2
AWS_REGION_SECONDARY=us-west-2
API_DOMAIN_NAME=api.example.com
HOSTED_ZONE_ID=Z0000000000000
GITHUB_REPOSITORY=example/aws-multi-region-aurora-failover-active-passive
DB_INSTANCE_CLASS=db.r6g.large
ENGINE_VERSION=16.15
ALERT_EMAIL=
# Optional: Deploy role ARN created by bootstrap stack (synced as a secret to GitHub Environment)
AWS_ROLE_ARN=
