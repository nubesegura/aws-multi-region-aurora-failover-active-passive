<mxfile host="app.diagrams.net"><diagram id="DR demo layers" name="DR demo layers"><mxGraphModel dx="2440" dy="1900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2440" pageHeight="1900" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane0" value="Client tier" style="swimlane;horizontal=0;startSize=60;fillColor=#f5f5f5;html=1;fontStyle=1;fontSize=15;strokeColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="2400" height="240" as="geometry"/></mxCell><mxCell id="lane1" value="Edge and identity tier" style="swimlane;horizontal=0;startSize=60;fillColor=#e8f4f8;html=1;fontStyle=1;fontSize=15;strokeColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="350" width="2400" height="240" as="geometry"/></mxCell><mxCell id="lane2" value="API tier" style="swimlane;horizontal=0;startSize=60;fillColor=#f3e9f7;html=1;fontStyle=1;fontSize=15;strokeColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="590" width="2400" height="240" as="geometry"/></mxCell><mxCell id="lane3" value="Compute tier" style="swimlane;horizontal=0;startSize=60;fillColor=#e8f5e9;html=1;fontStyle=1;fontSize=15;strokeColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="830" width="2400" height="240" as="geometry"/></mxCell><mxCell id="lane4" value="Data tier" style="swimlane;horizontal=0;startSize=60;fillColor=#fff0e6;html=1;fontStyle=1;fontSize=15;strokeColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="1070" width="2400" height="240" as="geometry"/></mxCell><mxCell id="lane5" value="Platform tier" style="swimlane;horizontal=0;startSize=60;fillColor=#fce4ec;html=1;fontStyle=1;fontSize=15;strokeColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="1310" width="2400" height="240" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;AWS DR demo - layered view (prod, active-standby: us-east-2 primary at creation, us-west-2 secondary, us-east-1 global stacks)&lt;/b&gt;&lt;br&gt;Request path from the browser to the data, and the platform around it. Solid arrow: request or data path. Dashed arrow: DNS, standby path or asynchronous replication." style="text;html=1;whiteSpace=wrap;overflow=hidden;verticalAlign=top;align=left;fontSize=16;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="18" width="2400" height="80" as="geometry"/></mxCell><mxCell id="browser" value="&lt;b&gt;Presenter browser&lt;/b&gt;&lt;br&gt;online banking app (bank-operator) and&lt;br&gt;DR monitoring dashboard (dashboard-viewer)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;dashed=0;verticalAlign=middle;align=center;fontSize=13;fontStyle=0;fontColor=#232F3E;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="400" y="180" width="540" height="120" as="geometry"/></mxCell><mxCell id="s3b" value="&lt;b&gt;S3 banking bucket&lt;/b&gt;&lt;br&gt;private, versioned, read&lt;br&gt;only through OAC" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;strokeWidth=1;dashed=0;verticalAlign=middle;align=center;fontSize=13;fontStyle=0;fontColor=#232F3E;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="110" y="420" width="250" height="120" as="geometry"/></mxCell><mxCell id="cfb" value="&lt;b&gt;CloudFront (banking)&lt;/b&gt;&lt;br&gt;*.cloudfront.net, HTTPS,&lt;br&gt;CSP and HSTS headers" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;strokeWidth=1;dashed=0;verticalAlign=middle;align=center;fontSize=13;fontStyle=0;fontColor=#232F3E;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="400" y="420" width="250" height="120" as="geometry"/></mxCell><mxCell id="cfm" value="&lt;b&gt;CloudFront (monitor)&lt;/b&gt;&lt;br&gt;own address, same OAC&lt;br&gt;and headers policy" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;strokeWidth=1;dashed=0;verticalAlign=middle;align=center;fontSize=13;fontStyle=0;fontColor=#232F3E;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="690" y="420" width="250" height="120" as="geometry"/></mxCell><mxCell id="s3m" value="&lt;b&gt;S3 monitor bucket&lt;/b&gt;&lt;br&gt;private, versioned, read&lt;br&gt;only through OAC" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;strokeWidth=1;dashed=0;verticalAlign=middle;align=center;fontSize=13;fontStyle=0;fontColor=#232F3E;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="980" y="420" width="250" height="120" as="geometry"/></mxCell><mxCell id="cogP" value="&lt;b&gt;Cognito user pool (us-east-2)&lt;/b&gt;&lt;br&gt;primary, Essentials, KMS&lt;br&gt;multi-Region key, 2 clients" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8d7da;strokeColor=#b85450;strokeWidth=1;dashed=0;verticalAlign=middle;align=center;fontSize=13;fontStyle=0;fontColor=#232F3E;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1270" y="420" width="250" height="120" as="geometry"/></mxCell><mxCell id="cogR" value="&lt;b&gt;Cognito replica (us-west-2)&lt;/b&gt;&lt;br&gt;same pool and client IDs,&lt;br&gt;attachment INACTIVE at rest" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8d7da;strokeColor=#b85450;strokeWidth=1;dashed=0;verticalAlign=middle;align=center;fontSize=13;fontStyle=0;fontColor=#232F3E;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1560" y="420" width="250" height="120" as="geometry"/></mxCell><mxCell id="r53" value="&lt;b&gt;Route 53 (us-east-1)&lt;/b&gt;&lt;br&gt;weighted alias, one API&lt;br&gt;domain: use2 255, usw2 0" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;strokeWidth=1;dashed=0;verticalAlign=middle;align=center;fontSize=13;fontStyle=0;fontColor=#232F3E;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1850" y="420" width="250" height="120" as="geometry"/></mxCell><mxCell id="apiE" value="&lt;b&gt;API Gateway REST (us-east-2)&lt;/b&gt;&lt;br&gt;regional custom domain TLS 1.2,&lt;br&gt;Cognito authorizer, 20/40 rps" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1;dashed=0;verticalAlign=middle;align=center;fontSize=13;fontStyle=0;fontColor=#232F3E;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1850" y="660" width="250" height="120" as="geometry"/></mxCell><mxCell id="apiW" value="&lt;b&gt;API Gateway REST (us-west-2)&lt;/b&gt;&lt;br&gt;same template, authorizer&lt;br&gt;on the replica pool" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1;dashed=0;verticalAlign=middle;align=center;fontSize=13;fontStyle=0;fontColor=#232F3E;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="2140" y="660" width="250" height="120" as="geometry"/></mxCell><mxCell id="apinote" value="Routes: POST /transactions, GET /transactions, /stats, /account, /consistency need Authorization: Bearer ID token; GET /health and the CORS preflight need none. No API key, no usage plan, no WAF (accepted risk)." style="text;html=1;whiteSpace=wrap;overflow=hidden;verticalAlign=top;align=left;fontSize=14;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="110" y="670" width="1660" height="110" as="geometry"/></mxCell><mxCell id="fnE" value="&lt;b&gt;6 Lambda functions (us-east-2)&lt;/b&gt;&lt;br&gt;python3.14 arm64, VPC 10.40.0.0/24&lt;br&gt;private subnets, no NAT" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;dashed=0;verticalAlign=middle;align=center;fontSize=13;fontStyle=0;fontColor=#232F3E;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1850" y="900" width="250" height="120" as="geometry"/></mxCell><mxCell id="fnW" value="&lt;b&gt;6 Lambda functions (us-west-2)&lt;/b&gt;&lt;br&gt;same code, VPC 10.41.0.0/24&lt;br&gt;private subnets, no NAT" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;dashed=0;verticalAlign=middle;align=center;fontSize=13;fontStyle=0;fontColor=#232F3E;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="2140" y="900" width="250" height="120" as="geometry"/></mxCell><mxCell id="fnnote" value="create-transaction is the only writer (balance and ledger under a row lock); list-transactions, get-stats, get-account, get-consistency and get-health only read. One IAM role per function. The drill fences a region by setting reserved concurrency 0 on its six functions." style="text;html=1;whiteSpace=wrap;overflow=hidden;verticalAlign=top;align=left;fontSize=14;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="110" y="910" width="1660" height="110" as="geometry"/></mxCell><mxCell id="dbE" value="&lt;b&gt;Aurora PostgreSQL 16.15&lt;/b&gt;&lt;br&gt;us-east-2, writer at creation,&lt;br&gt;db.r6g.large, global cluster" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1;dashed=0;verticalAlign=middle;align=center;fontSize=13;fontStyle=0;fontColor=#232F3E;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1850" y="1140" width="250" height="120" as="geometry"/></mxCell><mxCell id="dbW" value="&lt;b&gt;Aurora PostgreSQL 16.15&lt;/b&gt;&lt;br&gt;us-west-2, reader at creation,&lt;br&gt;db.r6g.large" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1;dashed=0;verticalAlign=middle;align=center;fontSize=13;fontStyle=0;fontColor=#232F3E;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="2140" y="1140" width="250" height="120" as="geometry"/></mxCell><mxCell id="kmsC" value="&lt;b&gt;KMS multi-Region key&lt;/b&gt;&lt;br&gt;us-east-2 primary, encrypts&lt;br&gt;Cognito credentials" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1;dashed=0;verticalAlign=middle;align=center;fontSize=13;fontStyle=0;fontColor=#232F3E;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1270" y="1140" width="250" height="120" as="geometry"/></mxCell><mxCell id="kmsR" value="&lt;b&gt;KMS replica key&lt;/b&gt;&lt;br&gt;us-west-2, used by the&lt;br&gt;Cognito replica" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1;dashed=0;verticalAlign=middle;align=center;fontSize=13;fontStyle=0;fontColor=#232F3E;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1560" y="1140" width="250" height="120" as="geometry"/></mxCell><mxCell id="gh" value="&lt;b&gt;GitHub Actions&lt;/b&gt;&lt;br&gt;deploy, destroy, simulate-&lt;br&gt;outage, failover (manual)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1;dashed=0;verticalAlign=middle;align=center;fontSize=13;fontStyle=0;fontColor=#232F3E;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="110" y="1380" width="250" height="120" as="geometry"/></mxCell><mxCell id="exec" value="&lt;b&gt;CloudFormation execution role&lt;/b&gt;&lt;br&gt;bootstrap stack us-east-1,&lt;br&gt;plus artifact buckets" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1;dashed=0;verticalAlign=middle;align=center;fontSize=13;fontStyle=0;fontColor=#232F3E;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="400" y="1380" width="250" height="120" as="geometry"/></mxCell><mxCell id="base" value="&lt;b&gt;Account baseline&lt;/b&gt;&lt;br&gt;other repository: GitHub OIDC&lt;br&gt;provider, API Gateway log role" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#7f7f7f;strokeWidth=1;dashed=1;verticalAlign=middle;align=center;fontSize=13;fontStyle=0;fontColor=#232F3E;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="690" y="1380" width="250" height="120" as="geometry"/></mxCell><mxCell id="ssm" value="&lt;b&gt;SSM parameters&lt;/b&gt;&lt;br&gt;pool ID, pool ARN and&lt;br&gt;client IDs per region" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1;dashed=0;verticalAlign=middle;align=center;fontSize=13;fontStyle=0;fontColor=#232F3E;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="980" y="1380" width="250" height="120" as="geometry"/></mxCell><mxCell id="cw" value="&lt;b&gt;CloudWatch&lt;/b&gt;&lt;br&gt;logs 30 days (KMS), 8 alarms&lt;br&gt;per region" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1;dashed=0;verticalAlign=middle;align=center;fontSize=13;fontStyle=0;fontColor=#232F3E;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1270" y="1380" width="250" height="120" as="geometry"/></mxCell><mxCell id="sns" value="&lt;b&gt;SNS alert topic&lt;/b&gt;&lt;br&gt;per region, KMS encrypted,&lt;br&gt;receives the alarms" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1;dashed=0;verticalAlign=middle;align=center;fontSize=13;fontStyle=0;fontColor=#232F3E;spacingLeft=14;spacingRight=14;spacingTop=