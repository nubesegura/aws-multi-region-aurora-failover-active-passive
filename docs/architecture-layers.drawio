rColor=#232F3E;fontStyle=1;fontSize=14;fontColor=#232F3E;" edge="1" parent="1" source="fnE" target="dbE"><mxGeometry x="0.45" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e13" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#232F3E;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;labelBorderColor=#232F3E;fontStyle=1;fontSize=14;fontColor=#232F3E;" edge="1" parent="1" source="fnW" target="dbW"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="11" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#232F3E;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;labelBorderColor=#232F3E;fontStyle=1;fontSize=14;fontColor=#232F3E;" edge="1" parent="1" source="dbE" target="dbW"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="12" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#232F3E;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;labelBorderColor=#232F3E;fontStyle=1;fontSize=14;fontColor=#232F3E;" edge="1" parent="1" source="cogP" target="cogR"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="13" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#232F3E;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;labelBorderColor=#232F3E;fontStyle=1;fontSize=14;fontColor=#232F3E;" edge="1" parent="1" source="gh" target="exec"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="legend" value="" style="rounded=1;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#232F3E;strokeWidth=1;dashed=0;verticalAlign=top;align=left;fontSize=14;fontStyle=1;fontColor=#232F3E;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="20" y="1590" width="2400" height="270" as="geometry"/></mxCell><mxCell id="legL" value="&lt;b&gt;Flow legend&lt;/b&gt;&lt;br&gt;[1] [2] The online banking app loads from its own CloudFront distribution, which reads a private S3 bucket (OAC).&lt;br&gt;[3] [4] The read-only DR monitoring dashboard loads from a second distribution and its own private bucket.&lt;br&gt;[5] The browser signs in directly to Cognito (USER_PASSWORD_AUTH) and keeps a 15-minute ID token; after a failover it signs in again against the replica in us-west-2.&lt;br&gt;[6] The browser resolves the single API domain in Route 53 (dashed: DNS, about 60 s TTL) and sends the ID token as Bearer.&lt;br&gt;[7] Weight 255 sends every call to the active region. [8] Weight 0 keeps the standby region idle (dashed).&lt;br&gt;[9] API Gateway validates the token with its regional Cognito authorizer and proxies to the function of the route, which re-checks aud and token_use.&lt;br&gt;[10] The functions reach Aurora on 5432 over TLS with IAM database authentication (app_writer or app_reader).&lt;br&gt;[11] Aurora Global Database replicates asynchronously to us-west-2 (dashed). [12] Cognito multi-Region replication copies users and credentials to the replica (dashed).&lt;br&gt;[13] GitHub Actions assumes the organization role through OIDC and deploys every stack through the execution role." style="text;html=1;whiteSpace=wrap;overflow=hidden;verticalAlign=top;align=left;fontSize=14;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="1605" width="1160" height="250" as="geometry"/></mxCell><mxCell id="legR" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;Failover (workflow failover.yml): fence the old region (reserved concurrency 0), activate the replica attachment, planned switchover of the global cluster, then move the Route 53 weights; failback reverses the order. These control-plane calls are not drawn.&lt;br&gt;The dns stack and the global bootstrap stay in us-east-1 so the weight switch works while us-east-2 is down.&lt;br&gt;No internet gateway, NAT or VPC endpoints: the functions reach only the database; security groups allow 5432 from the function group only.&lt;br&gt;Not drawn: one IAM role per function, CloudWatch logs and alarms of every component, KMS encryption at rest.&lt;br&gt;The components view (architecture.drawio) shows the same system as AWS resources, account, regions and VPCs." style="text;html=1;whiteSpace=wrap;overflow=hidden;verticalAlign=top;align=left;fontSize=14;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1230" y="1605" width="1170" height="250" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>