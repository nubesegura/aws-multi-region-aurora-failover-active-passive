<mxfile host="app.diagrams.net"><diagram id="dr-failback-flow" name="dr-failback-flow"><mxGraphModel dx="1900" dy="1270" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1270" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Failback: us-west-2 &amp;#8594; us-east-2 (return to the primary region)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;verticalAlign=top;align=left;fontSize=28;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1820" height="40" as="geometry"/></mxCell><mxCell id="sub" value="Workflow &lt;b&gt;demo-3-failback&lt;/b&gt; (no inputs; same as &lt;b&gt;failover&lt;/b&gt;, direction to-primary). The fence is lifted first, then the database roles, then the weights. Measured in the drill of 2026-11-11: write RTO 83 s, RPO 0." style="text;html=1;whiteSpace=wrap;overflow=hidden;verticalAlign=top;align=left;fontSize=16;fontColor=#5F6B7A;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1820" height="50" as="geometry"/></mxCell><mxCell id="lane_steps" value="GitHub Actions workflow steps" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#232F3E;strokeWidth=2;dashed=0;verticalAlign=top;align=left;fontSize=16;fontStyle=1;fontColor=#232F3E;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="30" y="150" width="490" height="980" as="geometry"/></mxCell><mxCell id="lane_use2" value="us-east-2 (primary at rest)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F2F8FD;strokeColor=#232F3E;strokeWidth=2;dashed=0;verticalAlign=top;align=left;fontSize=16;fontStyle=1;fontColor=#232F3E;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="540" y="150" width="420" height="980" as="geometry"/></mxCell><mxCell id="lane_glob" value="Global (Route 53 public DNS)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F7F2FD;strokeColor=#232F3E;strokeWidth=2;dashed=1;verticalAlign=top;align=left;fontSize=16;fontStyle=1;fontColor=#232F3E;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="990" y="150" width="380" height="980" as="geometry"/></mxCell><mxCell id="lane_usw2" value="us-west-2 (secondary at rest)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F2FBF2;strokeColor=#232F3E;strokeWidth=2;dashed=0;verticalAlign=top;align=left;fontSize=16;fontStyle=1;fontColor=#232F3E;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1400" y="150" width="460" height="980" as="geometry"/></mxCell><mxCell id="band0" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;strokeWidth=1.5;dashed=1;verticalAlign=top;align=left;fontSize=14;fontStyle=1;fontColor=#232F3E;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;opacity=85;" vertex="1" parent="1"><mxGeometry x="508" y="220" width="1344" height="110" as="geometry"/></mxCell><mxCell id="s0" value="&lt;b&gt;1. Unfence us-east-2&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;Removes the reserved concurrency. Functions answer again, but the database there is still a reader.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=2;dashed=0;verticalAlign=middle;align=left;fontSize=15;fontStyle=0;fontColor=#232F3E;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="40" y="225" width="470" height="100" as="geometry"/></mxCell><mxCell id="i0use2" value="6 Lambda functions&lt;br&gt;&lt;span style=&#x27;color:#5F6B7A&#x27;&gt;fenced (concurrency 0)&lt;/span&gt; &amp;#8594; &lt;b&gt;&lt;span style=&#x27;color:#1D8102&#x27;&gt;serving&lt;/span&gt;&lt;/b&gt;" style="sketch=0;outlineConnect=0;html=1;whiteSpace=nowrap;aspect=fixed;fontSize=17;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="561" y="236" width="78" height="78" as="geometry"/></mxCell><mxCell id="band1" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;strokeWidth=1.5;dashed=1;verticalAlign=top;align=left;fontSize=14;fontStyle=1;fontColor=#232F3E;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;opacity=85;" vertex="1" parent="1"><mxGeometry x="508" y="370" width="1344" height="110" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;2. Aurora planned switchover back&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;Waits for replication to catch up, then swaps roles again. No data loss. About 35 s.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=2;dashed=0;verticalAlign=middle;align=left;fontSize=15;fontStyle=0;fontColor=#232F3E;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="40" y="375" width="470" height="100" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#232F3E;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;labelBorderColor=#232F3E;fontStyle=1;fontSize=14;fontColor=#232F3E;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="i1use2" value="Aurora cluster&lt;br&gt;&lt;span style=&#x27;color:#5F6B7A&#x27;&gt;reader&lt;/span&gt; &amp;#8594; &lt;b&gt;&lt;span style=&#x27;color:#1D8102&#x27;&gt;writer&lt;/span&gt;&lt;/b&gt;" style="sketch=0;outlineConnect=0;html=1;whiteSpace=nowrap;aspect=fixed;fontSize=17;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.aurora;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="561" y="386" width="78" height="78" as="geometry"/></mxCell><mxCell id="i1usw2" value="Aurora cluster&lt;br&gt;&lt;span style=&#x27;color:#5F6B7A&#x27;&gt;writer&lt;/span&gt; &amp;#8594; &lt;b&gt;&lt;span style=&#x27;color:#C7131F&#x27;&gt;reader&lt;/span&gt;&lt;/b&gt;" style="sketch=0;outlineConnect=0;html=1;whiteSpace=nowrap;aspect=fixed;fontSize=17;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.aurora;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1421" y="386" width="78" height="78" as="geometry"/></mxCell><mxCell id="band2" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;strokeWidth=1.5;dashed=1;verticalAlign=top;align=left;fontSize=14;fontStyle=1;fontColor=#232F3E;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;opacity=85;" vertex="1" parent="1"><mxGeometry x="508" y="520" width="1344" height="110" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;3. Deactivate the Cognito replica&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;CloudFormation update of the cognito stack in us-west-2. Sign-in goes back to the primary pool.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=2;dashed=0;verticalAlign=middle;align=left;fontSize=15;fontStyle=0;fontColor=#232F3E;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="40" y="525" width="470" height="100" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#232F3E;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;labelBorderColor=#232F3E;fontStyle=1;fontSize=14;fontColor=#232F3E;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="i2usw2" value="Cognito replica attachment&lt;br&gt;&lt;span style=&#x27;color:#5F6B7A&#x27;&gt;ACTIVE&lt;/span&gt; &amp;#8594; &lt;b&gt;&lt;span style=&#x27;color:#5F6B7A&#x27;&gt;INACTIVE&lt;/span&gt;&lt;/b&gt;" style="sketch=0;outlineConnect=0;html=1;whiteSpace=nowrap;aspect=fixed;fontSize=17;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1421" y="536" width="78" height="78" as="geometry"/></mxCell><mxCell id="band3" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;strokeWidth=1.5;dashed=1;verticalAlign=top;align=left;fontSize=14;fontStyle=1;fontColor=#232F3E;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;opacity=85;" vertex="1" parent="1"><mxGeometry x="508" y="670" width="1344" height="110" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;4. Switch the Route 53 weights back&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;Update of the dns stack (us-east-1). Users reach the API in us-east-2 again.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=2;dashed=0;verticalAlign=middle;align=left;fontSize=15;fontStyle=0;fontColor=#232F3E;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="40" y="675" width="470" height="100" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#232F3E;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;labelBorderColor=#232F3E;fontStyle=1;fontSize=14;fontColor=#232F3E;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="i3glob" value="Weighted records&lt;br&gt;use2 / usw2&lt;br&gt;&lt;span style=&#x27;color:#5F6B7A&#x27;&gt;0 / 255&lt;/span&gt; &amp;#8594; &lt;b&gt;&lt;span style=&#x27;color:#1D8102&#x27;&gt;255 / 0&lt;/span&gt;&lt;/b&gt;" style="sketch=0;outlineConnect=0;html=1;whiteSpace=nowrap;aspect=fixed;fontSize=17;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.route_53;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1011" y="686" width="78" height="78" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;5. Validate on the public API name&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;GET /health?deep=true must answer from us-east-2 with database role writer.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF6EE;strokeColor=#1D8102;strokeWidth=2;dashed=0;verticalAlign=middle;align=left;fontSize=15;fontStyle=0;fontColor=#232F3E;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="40" y="825" width="470" height="100" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#232F3E;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;labelBorderColor=#232F3E;fontStyle=1;fontSize=14;fontColor=#232F3E;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s5" value="&lt;b&gt;6. Ledger consistency check&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;Replays the ledger: no movement lost or duplicated. Needs a Cognito token.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF6EE;strokeColor=#1D8102;strokeWidth=2;dashed=0;verticalAlign=middle;align=left;fontSize=15;fontStyle=0;fontColor=#232F3E;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="40" y="975" width="470" height="100" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#232F3E;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;labelBorderColor=#232F3E;fontStyle=1;fontSize=14;fontColor=#232F3E;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="foot" value="&lt;b&gt;Legend.&lt;/b&gt; White box: step that changes an AWS resource. Green box: read-only check. Amber box: step before the failover. Each icon shows the resource that changes in that step as &lt;i&gt;before &amp;#8594; after&lt;/i&gt;. Resources not shown do not change (API Gateway, the code of the functions, Cognito primary pool, CloudFront sites). The workflow stops at the first failing step and leaves the state as it is.&lt;br&gt;&lt;br&gt;&lt;b&gt;End state:&lt;/b&gt; back to the resting state. us-east-2 serves reads and writes; us-west-2 is a reader with the Cognito replica INACTIVE." style="text;html=1;whiteSpace=wrap;overflow=hidden;verticalAlign=top;align=left;fontSize=15;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="1150" width="1820" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>